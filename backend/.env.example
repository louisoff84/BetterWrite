# Application Node.js
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://betterwrite.example.com
# Laisser vide : frontend et API partagent la même origine.
FRONTEND_ORIGIN=
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters
DATABASE_PATH=/data/betterwrite.sqlite

# Facultatif : Google Drive / Google Docs OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://betterwrite.example.com/api/import/google/callback
